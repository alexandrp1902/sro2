{
  "startCredits": 1000,
  "repairPrice": 0.25,
  "sellShare": 0.5,
  // Доля цены корпуса за полный ремонт (M12): «Пчелу» латать даром, «Титана» — за 3 600 сверху.
  "repairHullShare": 0.06,

  // Множители старших тиров (M11): первый — Mk2, второй — Mk3. Раскрывают weapons.json и modules.json.
  "tiers": [
    { "stat": 1.25, "power": 1.15, "price": 3, "engine": 1.5, "radar": 1.1 },
    { "stat": 1.5, "power": 1.3, "price": 8, "engine": 2, "radar": 1.2 }
  ],

  "hulls": {
    "light": 0,
    "scout": 2500,
    "medium": 3000,
    "industrial": 5000,
    "interceptor": 9000,
    "heavy": 8000,
    "frigate": 18000,
    "freighter": 26000,
    "cruiser": 60000
  },
  "items": {
    "pulse": 300,
    "laser": 800,
    "cannon": 1500,
    "plasma": 1800,
    "missiles": 2500,
    "heavyLaser": 4500,
    "ion": 2200,
    "pointDefense": 900,
    "railgun": 6000,
    "torpedoes": 7000,
    "engineS": 200,
    "engineM": 1500,
    "engineL": 4000,
    "afterburnerM": 2200,
    "afterburnerL": 5000,
    "shieldS": 200,
    "shieldM": 1500,
    "shieldL": 4000,
    "radarS": 150,
    "radarM": 1000,
    "radarL": 2500,
    "generatorS": 200,
    "generatorM": 1500,
    "generatorL": 4000,
    "repair": 1200,
    "cooling": 1500,
    "cargoPod": 800,
    "thrusters": 1400,
    "dustCloud": 1600,
    "reactiveArmor": 1800,
    "antiMissile": 2600
  },

  // Тариф буксира (M15.6): перегон своего корпуса из другого дока сюда.
  // Цена = base + прыжки × (perJump + hullShare × цена корпуса), вверх до целого.
  // «Пчела» за прыжок — 1 200, «Титан» за пять — 19 400: треть его цены за переезд через галактику,
  // так что лететь за ним самому остаётся выбором по умолчанию, а буксир — удобством.
  "transport": { "base": 400, "perJump": 800, "hullShare": 0.05 },

  // Цены снятого с баланса: по ним вход выкупает у пилота то, чего в игре больше нет (M15.6 — баки,
  // вместе с топливом). Купить это нельзя — в ассортименте его нет, — а вернуть кредиты можно.
  // Когда на диске не останется профилей с баком, блок можно убрать целиком.
  "legacy": {
    "tankS": 100,
    "tankM": 600,
    "tankL": 1500
  },

  // Ассортимент по регионам галактики (M11): чем дальше от Sol, тем лучше снаряжение и выше тир.
  "regions": {
    "core": {
      "tiers": [1, 2],
      "hulls": ["light", "scout", "medium", "industrial"],
      "items": [
        "pulse", "laser", "cannon", "missiles",
        "engineS", "engineM", "shieldS", "shieldM", "radarS", "radarM",
        "generatorS", "generatorM", "cargoPod", "repair", "thrusters"
      ]
    },
    "frontier": {
      "tiers": [1, 2],
      "hulls": ["scout", "medium", "industrial", "interceptor", "heavy", "frigate"],
      "items": [
        "pulse", "laser", "cannon", "plasma", "missiles", "heavyLaser", "ion", "pointDefense",
        "engineM", "engineL", "afterburnerM", "shieldM", "shieldL", "radarM", "radarL",
        "generatorM", "generatorL", "cargoPod", "repair", "cooling",
        "thrusters", "dustCloud", "antiMissile"
      ]
    },
    "rim": {
      "tiers": [2, 3],
      "hulls": ["interceptor", "heavy", "frigate", "freighter", "cruiser"],
      "items": [
        "plasma", "heavyLaser", "missiles", "ion", "pointDefense", "railgun", "torpedoes",
        "engineL", "afterburnerL", "shieldL", "radarL", "generatorL",
        "cargoPod", "repair", "cooling",
        "dustCloud", "reactiveArmor", "antiMissile"
      ]
    }
  },

  // Личные отличия мест: что добавили, чего нет и как плавают цены.
  // Ключ — место (M15): «st:<система>» — станция, «pl:<планета>» — поселение.
  "places": {
    "st:sol": { "title": "Торговый порт Сол" },
    "st:vega": { "title": "Верфь Веги", "items": ["heavyLaser"], "price": 1.05 },
    "st:alphaCen": { "title": "Причал Альфы", "remove": ["cannon"], "price": 0.92 },
    "st:castor": { "title": "Шахтёрский склад Кастора", "hulls": ["freighter"], "items": ["cargoPod"], "price": 0.95 },
    "st:nova": { "title": "Военная станция Нова", "items": ["railgun", "reactiveArmor"], "price": 1.1 },
    "st:barnard": { "title": "Пост рейнджеров Барнарда", "items": ["pointDefense", "ion", "repair", "antiMissile"], "price": 1.05 },
    "st:aldebaran": { "title": "Крепость Альдебарана", "items": ["torpedoes"], "price": 1.12 },
    "st:epsilon": { "title": "Вольная гавань Эпсилона", "hulls": ["cruiser"], "price": 1.15 },

    // Поселения (M15). На поверхности снаряжение дешевле, чем на орбите, но выбор беднее: чинят
    // везде, а корпуса продают лишь там, где верфь (см. settlement.shipyard в galaxy.json).
    "pl:terra": { "title": "Порт Новый Порт", "price": 0.95 },
    "pl:vegaOne": { "title": "Склад Ледяной Веги", "remove": ["heavyLaser"], "price": 0.93 },
    "pl:alphaTwo": { "title": "Лавка Купола Альфы", "remove": ["cannon"], "price": 0.9 },
    "pl:tauPrima": { "title": "Верфь Пыльной Гавани", "hulls": ["industrial"], "items": ["cargoPod"], "price": 0.97 },
    "pl:novaGiant": { "title": "Причал Нова-Один", "items": ["cargoPod"], "price": 1.02 },
    "pl:castorOre": { "title": "Контора Рудника", "items": ["cargoPod"], "price": 0.92 },
    "pl:barnardGarden": { "title": "Лавка Оранжереи", "items": ["repair"], "price": 1.0 },
    "pl:sigmaIce": { "title": "Верфь Мороза", "hulls": ["freighter"], "items": ["cooling"], "price": 1.05 },
    "pl:aldPyre": { "title": "Плавильня", "items": ["railgun", "reactiveArmor"], "price": 1.08 },
    "pl:edgeAsh": { "title": "Верфь Пепельного Приюта", "hulls": ["frigate"], "items": ["torpedoes"], "price": 1.1 }
  }
}
