{
  // Рынок товаров (M12). Название, объём и базовая цена товара — в loot.json, здесь только торговля.
  //
  // Цена на станции = базовая × уровень × (норма запаса / запас) ^ elasticity, зажатая в minFactor..maxFactor.
  // Уровень задаёт, насколько тут вообще дорого (производят — дёшево, скупают — дорого), норма запаса —
  // насколько сильно цену двигает одна сделка. Это разные рычаги: если крутить только норму, все свежие
  // станции стояли бы на базовой цене и разницы между регионами не было бы.

  "spread": 0.18,          // станция продаёт дороже, чем скупает: ±9 % от справедливой цены
  "elasticity": 0.6,       // насколько круто цена отзывается на отклонение запаса от нормы
  "minFactor": 0.45,       // цена не ниже 45 % базовой…
  "maxFactor": 2.2,        // …и не выше 220 %
  "stockFloor": 0.08,      // ниже этой доли нормы запас в формуле не опускается: иначе деление на ноль
  "stockCap": 3,           // выше нормы × 3 запас не растёт: затоваренный склад не отдаёт даром
  "halfLifeSeconds": 600,  // за 10 минут запас проходит половину пути к норме
  "tickSeconds": 5,        // как часто считается возврат

  "produceMul": 0.7,       // производитель отдаёт дешевле справедливой цены…
  "consumeMul": 1.45,      // …потребитель платит дороже
  "produceStock": 2.5,     // у производителя склад большой: крупная сделка его почти не двигает
  "consumeStock": 0.5,     // у потребителя склад мал: цена отзывается резко
  "illegalMul": 1.6,       // контрабанда стоит дороже там, где она вне закона

  "traderUnits": 8,        // сколько единиц двигает один NPC-торговец: довёз — цена упала, сбили — осталась высокой
  "baseline": 100,         // норма запаса по умолчанию, штук

  // Чем вообще торгуют. Каждый id — груз из loot.json. Чем меньше baseline, тем резче ходит цена.
  "goods": {
    "ore": { "baseline": 260 },
    "metal": { "baseline": 260 },
    "titanium": { "baseline": 140 },
    "energy": { "baseline": 110 },
    "crystals": { "baseline": 70 },
    "rareMetal": { "baseline": 45 },
    "tech": { "baseline": 30 },

    "food": { "baseline": 240 },
    "fuelCells": { "baseline": 150 },
    "medicine": { "baseline": 100 },
    "machinery": { "baseline": 90 },
    "luxury": { "baseline": 45 },
    // Оружие вне закона в Ядре: там его не купить и не продать. Наказание за перевозку придёт с репутацией в M13.
    "arms": { "baseline": 60, "illegal": ["core"] }
  },

  // Профили мест. produces — делают тут, дёшево и много; consumes — тут этого не хватает, скупают дорого.
  // Один товар не может быть и там, и там. Ключ — место (M15): «st:<система>» — станция, «pl:<планета>» — поселение.
  //
  // Маршрут, который из этого складывается: из Ядра на Рубеж везут продовольствие, медикаменты и машины,
  // обратно — редкие металлы, кристаллы и плазменные компоненты. Кастор — рудная остановка в Пограничье,
  // Nova и Барнард дают короткое рискованное плечо на оружии.
  "places": {
    "st:sol": {
      "produces": ["food", "machinery", "medicine"],
      "consumes": ["rareMetal", "crystals", "titanium", "fuelCells"]
    },
    "st:vega": {
      "produces": ["machinery", "tech", "metal"],
      "consumes": ["ore", "titanium", "rareMetal", "food"]
    },
    "st:alphaCen": {
      "produces": ["food", "luxury"],
      "consumes": ["ore", "crystals", "arms", "fuelCells"]
    },

    "st:castor": {
      "produces": ["ore", "metal", "titanium"],
      "consumes": ["food", "medicine", "machinery", "luxury"]
    },
    "st:nova": {
      "produces": ["arms", "energy"],
      "consumes": ["food", "medicine", "fuelCells", "machinery"]
    },
    "st:barnard": {
      "produces": ["fuelCells", "medicine"],
      "consumes": ["arms", "machinery", "food", "luxury"]
    },

    "st:aldebaran": {
      "produces": ["crystals", "rareMetal"],
      "consumes": ["food", "medicine", "machinery", "fuelCells"]
    },
    "st:epsilon": {
      "produces": ["rareMetal", "tech", "arms"],
      "consumes": ["food", "luxury", "medicine", "machinery"]
    },

    // Поселения (M15). Планета торгует сырьём и едой, а покупает то, что делают на орбите и в Ядре:
    // машины, медикаменты, роскошь. Там, где в системе есть и станция, профили нарочно встречные —
    // короткий маршрут «поверхность ↔ орбита» на пару минут, без прыжка.
    "pl:terra": {
      "produces": ["food", "luxury"],
      "consumes": ["machinery", "ore", "metal"]
    },
    "pl:vegaOne": {
      "produces": ["ore", "fuelCells"],
      "consumes": ["machinery", "food", "medicine"]
    },
    "pl:alphaTwo": {
      "produces": ["ore", "metal"],
      "consumes": ["food", "machinery", "medicine"]
    },

    "pl:tauPrima": {
      "produces": ["ore", "titanium"],
      "consumes": ["food", "medicine", "machinery", "fuelCells"]
    },
    "pl:novaGiant": {
      "produces": ["fuelCells", "energy"],
      "consumes": ["food", "medicine", "luxury", "arms"]
    },
    "pl:castorOre": {
      "produces": ["ore", "titanium", "rareMetal"],
      "consumes": ["food", "medicine", "machinery"]
    },
    "pl:barnardGarden": {
      "produces": ["food", "medicine"],
      "consumes": ["machinery", "titanium", "arms", "luxury"]
    },

    "pl:sigmaIce": {
      "produces": ["crystals", "fuelCells"],
      "consumes": ["food", "medicine", "machinery", "tech"]
    },
    "pl:aldPyre": {
      "produces": ["rareMetal", "metal"],
      "consumes": ["food", "medicine", "machinery", "luxury"]
    },
    "pl:edgeAsh": {
      "produces": ["rareMetal", "crystals"],
      "consumes": ["food", "medicine", "machinery", "arms"]
    }
  }
}
