    // ради одной кампании, — но это шахтёры на рабочих буксирах, а не налётчики: бьются слабо,
    // головы их не стоят ничего, и своей таблицы дропа у них нет. Сюжетным их делает комната,
    // и тогда за них не платят и не меняют отношение вовсе.
    "rebel": {
      "name": "Повстанец",
      "hull": "tug",
      "weapons": ["pulse"],
