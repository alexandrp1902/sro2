  "patrolThrottle": 0.35,
  "outmatchRatio": 2,
  "levelScaling": { "hp": 0.2, "shield": 0.2, "damage": 0.1, "accuracy": 2, "bounty": 0.5 },
  "types": {
    "pirate": {
      "name": "Пират",
      "hull": "light",
      "weapons": ["pulse"],
      "hp": 300,
      "shield": 100,
      "damage": 0.45,
      "holdRange": 320,
      "retreatHp": 0.25,
      "bounty": 60
    },
    "heavyPirate": {
      "name": "Тяжёлый пират",
      "hull": "heavy",
      "weapons": ["plasma", "missiles"],
      "hp": 900,
      "shield": 300,
      "damage": 0.5,
      "holdRange": 420,
      "retreatHp": 0,
      "bounty": 200
    },
    "trader": {
      "name": "Торговец",
      "faction": "trader",
      // Грузовой «Мул», а не боевой «Странник» (M16a): торговец возит груз, а не воюет, —
      // и корпус у него должен читаться как грузовой. Прочность и щит всё равно свои, из типа.
      "hull": "industrial",
      "weapons": ["pulse"],
      "hp": 400,
      "shield": 100,
      "damage": 0.3
    },
    // Повстанцы «Тихой войны» (M20a). Фракция пиратская — иначе ИИ, бой и доска разошлись бы по швам
    // ради одной кампании, — но это шахтёры на рабочих буксирах, а не налётчики: бьются слабо,
    // головы их не стоят ничего, и своей таблицы дропа у них нет. Сюжетным их делает комната,
    // и тогда за них не платят и не меняют отношение вовсе.
    "rebel": {
      "name": "Повстанец",
      "hull": "tug",
      "look": "rebel",
      "weapons": ["pulse"],
      "hp": 260,
      "shield": 60,
      "damage": 0.3,
      "holdRange": 300,
      "retreatHp": 0.35,
      "bounty": 0
    },
    // Корпорация «Нова-Рудник» (M20b). Фракция пиратская по той же причине, что и у повстанцев: иначе
    // ИИ, бой и маскировка разошлись бы по швам ради одной кампании. Голов они не стоят и отношение
    // не двигают — за корпоративную охрану власти Новы спасибо не скажут, они её и послали.
    // Внешность «corp»: на экране это их собственные корпуса, а не пиратский силуэт.
    "corpGuard": {
      "name": "Охрана корпорации",
      "hull": "frigate",
      "look": "corp",
      "weapons": ["laser", "cannon"],
      "hp": 900,
      "shield": 320,
      "damage": 0.42,
      "holdRange": 380,
      "retreatHp": 0.2,
      "bounty": 0
    },
    // Курьер не воюет, он бежит: слабый корпус, одна пушка для вида и никакого желания драться.
    "corpCourier": {
      "name": "Курьер корпорации",
      "hull": "needle",
      "look": "corp",
      "weapons": ["pulse"],
      "hp": 260,
      "shield": 120,
      "damage": 0.2,
      "holdRange": 300,
      "retreatHp": 0.9,
      "bounty": 0
    },
    // Транспорт конвоя: возить умеет, огрызаться — почти нет, зато прочный, как и положено «Галеону».
    "corpConvoy": {
      "name": "Транспорт корпорации",
      "hull": "galleon",
      "look": "corp",
      "weapons": ["cannon"],
      "hp": 2200,
      "shield": 500,
      "damage": 0.3,
      "holdRange": 420,
      "retreatHp": 0,
      "bounty": 0
    },
    // «Тягач» Дана в четырнадцатой: фракция торговая — это конвой, который надо довести, а не добить.
    "rebelTug": {
      "name": "Тягач повстанцев",
      "faction": "trader",
      "hull": "tug",
      "look": "corp",
      "weapons": ["pulse"],
      "hp": 1300,
      "shield": 260,
      "damage": 0.25
    },
    "ranger": {
      "name": "Рейнджер",
      "faction": "ranger",
      // Лестница корпусов по уровню (M16a): первые два уровня — та же «Пчела», что у новичка,
      // дальше «Странник», а «Сокол» — уже к пятому. Раньше рейнджер любого уровня летал на «Страннике»,
      // и первый же патруль был новичку не по зубам.
      "hull": "medium",
      "hulls": ["light", "light", "medium", "medium", "interceptor"],
      "weapons": ["pulse", "laser"],
      // База срезана ради первого уровня, поэтому рост у рейнджера свой и круче общего: второй уровень
      // выходит примерно туда, где до M16a стоял первый, а четвёртый остаётся прежней силы.
      "hp": 300,
      "shield": 100,
      "damage": 0.28,
      "levelScaling": { "hp": 0.6, "shield": 0.6, "damage": 0.5, "accuracy": 2 },
      "holdRange": 360,
      "retreatHp": 0.3,
      "defendRange": 2500,
      "leashRange": 3500
    }
  }
}
