// События спроса (M15.5): на месте в красной зоне на срок вспыхивает нужда в нескольких товарах,
// и цена на них подскакивает в несколько раз — настолько, чтобы рейс через Рубеж окупал риск.
//
// Суть не в доставке, а в том, что туда слетятся все. Гружёные корабли сходятся в одну точку системы,
// где PvP свободен и убийство не стоит репутации, — и товар можно не везти, а отнять у того, кто уже
// довёз его до половины пути. Бой с пиратами тут декорация.
//
// Спрос конечен. Нужно столько-то единиц, а не «дорого, пока идёт событие»: иначе это бесконечный кран
// денег и спешить некуда. Квота выбрана — событие кончилось досрочно; срок вышел с неполной квотой —
// событие просто гаснет, без штрафов кому бы то ни было. Так и задумано: не довезли — значит не довезли.
//
// Событие живёт только в памяти: перезапуск сервера его гасит, и цены возвращаются к норме.
{
  "enabled": true,

  // Крупное, но редкое. Первый полный трюм «Мула» (75 единиц) идёт по множителям 4.5 → ~2.8 и приносит
  // порядка десяти тысяч — два часа обычной торговли за одну рискованную ходку. Вся квота отдаёт
  // тысяч восемнадцать на всех. Заметно выгоднее обычного рейса, но крейсер за одно событие не покупается.
  "firstMinutes": 8,
  "intervalMinutes": 40,
  // Анонс идёт на всю галактику до того, как откроется приёмка: это время долететь с другого конца.
  "announceSeconds": 90,
  "durationSeconds": 1200,

  // 180 единиц — это 3–5 полных трюмов: «Мул» возит 75, «Караван» 130.
  "quota": 180,
  "mul": 4.5,
  // Не единица: иначе последний трюм везти незачем, квота не выбирается никогда,
  // и «спрос закрыт» перестаёт случаться вовсе.
  "mulEnd": 2,
  // На старте склад обрушивается до этой доли нормы: нужда должна быть видна в ценах сразу.
  "crashShare": 0.15,
  // Потолок зачёта на пилота; 0 — без потолка. С квотой 180 и трюмом 75 один корабль её и так не закроет.
  "perPilot": 0,

  // Поводы. Товар переводится в «скупает» на срок события, поэтому любой повод ложится на любое место, —
  // и каждый тянет свой товар с другого конца галактики. Оружие к тому же вне закона в Ядре: везти его
  // на Рубеж и так история.
  "cases": [
    { "id": "revolt", "title": "Восстание", "goods": ["arms", "medicine"] },
    { "id": "plague", "title": "Эпидемия", "goods": ["medicine", "food"] },
    { "id": "blockade", "title": "Блокада", "goods": ["food", "fuelCells"] },
    { "id": "collapse", "title": "Обвал в шахте", "goods": ["machinery", "medicine"] }
  ]
}
