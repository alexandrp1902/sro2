{
  "offers": 4,
  "dangerBonus": 0.35,

  // Доска обновляется сама каждые 12 минут (M15.1): рейс в соседнюю систему и обратно — и работа другая.
  // Считается от unix-времени, так что граница у всех мест общая и переживает перезапуск сервера.
  // Реже — доска застаивается и приходится «прокручивать» её взятием и отказом; чаще — не успеваешь долететь.
  "refreshMinutes": 12,
  // Обучение (GDD §54). С M18 в профиле хранится id шага, а не номер: шаги можно вставлять и переставлять,
  // нельзя только переименовывать id — пилот на исчезнувшем шаге считается прошедшим обучение.
  // Что засчитывает шаг — «kind» (без него — сам id): undock, stop, drone, grab, sell, buy, jump, kill, board.
  // Уточнения: «place» — где продать или купить, «goods» — что именно, «system» — куда прыгнуть или где сбить.
  // «hintTouch» — подсказка для телефона; «{brake}» в подсказке — клавиша тормоза из раскладки игрока.
  // «buoy» у шага stop — смещение буя от места вылета в его осях: { "x": вдоль орбиты, "y": от звезды };
  // по умолчанию x 1500, y 0 — вдоль орбиты, подальше и от врат у края мира, и от жара звезды.
  "tutorial": [
    {
      "id": "undock",
      "title": "Вылетите со станции",
      "hint": "Кнопка «Вылет» посередине верхней строки станции",
      "reward": 0
    },
    {
      "id": "stop",
      "title": "Долетите до буя и остановитесь",
      "hint": "Тормоз — полный назад: удерживайте {brake}, пока скорость не упадёт до нуля",
      "hintTouch": "Стоп — двойной тап по стику",
      "reward": 50
    },
    {
      "id": "drone",
      "title": "Уничтожьте учебный дрон",
      "hint": "Выберите дрон тапом, кликом или Q / E и включите огонь: пробел или «ОГОНЬ»",
      "reward": 100
    },
    {
      "id": "grab",
      "title": "Подберите выпавший груз",
      "hint": "Выберите груз тапом или кликом, подлетите ближе и нажмите пробел или «ВЗЯТЬ»",
      "reward": 100
    },
    {
      "id": "sell",
      "title": "Продайте груз на станции",
      "hint": "Выберите станцию, подлетите и нажмите пробел или «ДОК»; в доке — «Продать»",
      "reward": 150
    },
    {
      "id": "jump",
      "title": "Совершите гиперпрыжок в Вегу",
      "hint": "Выберите врата «→ Вега», подлетите в фиолетовый круг и нажмите пробел или «ПРЫЖОК»",
      "system": "vega",
      "reward": 250
    },
    // M18: после прыжка обучение не обрывается — первый настоящий бой и вход в обычный цикл.
    // Пираты в Веге налетают сами, по одному-двое, первого и второго уровня.
    {
      "id": "pirate",
      "kind": "kill",
      "system": "vega",
      "title": "Сбейте пирата в Веге",
      "hint": "Пираты налетают к станции сами — ждите у неё, рядом с рейнджерами",
      "reward": 200
    },
    {
      "id": "board",
      "title": "Возьмите задание на доске",
      "hint": "Пристыкуйтесь к любой станции: доска заданий — первая вкладка дока",
      "reward": 100
    }
  ],

  // Обучение под путь (M15.5): чей путь не назван здесь — учится общим списком выше.
  // M18: торговый путь — круг, который потом можно летать самому, и каждое его плечо выгодно по market.json:
  // продовольствие Терры — на Ледяную Вегу (Вега I), её топливные ячейки — на станцию Сол, машины Сол —
  // обратно на Терру. Станция Сол продовольствие сама делает, поэтому первый рейс — не туда.
  // Старые id (undock, sell, buy, drone, jump) не переименовывать: по ним переводятся профили старше M18.
  "tutorials": {
    "trader": [
      {
        "id": "undock",
        "title": "Вылетите из Нового Порта",
        "hint": "Кнопка «Вылет» посередине верхней строки поселения",
        "reward": 0
      },
      {
        "id": "stop",
        "title": "Долетите до буя и остановитесь",
        "hint": "Тормоз — полный назад: удерживайте {brake}, пока скорость не упадёт до нуля",
        "hintTouch": "Стоп — двойной тап по стику",
        "reward": 50
      },
      {
        "id": "drone",
        "title": "Уничтожьте учебный дрон у станции Сол",
        "hint": "Отбиваться приходится и торговцу: выберите дрон и включите огонь — пробел или «ОГОНЬ»",
        "reward": 100
      },
      {
        "id": "jump",
        "system": "vega",
        "title": "Отвезите продовольствие в Вегу",
        "hint": "На Терре его растят, в Веге — ждут. Выберите врата «→ Вега», подлетите в фиолетовый круг и нажмите «ПРЫЖОК»",
        "reward": 250
      },
      {
        "id": "sell",
        "place": "pl:vegaOne",
        "goods": "food",
        "title": "Сядьте на Вегу I и продайте продовольствие",
        "hint": "Выберите планету Вега I, подлетите и нажмите «ПОСАДКА»; в поселении — вкладка «Груз», «Продать»",
        "reward": 200
      },
      {
        "id": "buyFuel",
        "kind": "buy",
        "place": "pl:vegaOne",
        "goods": "fuelCells",
        "title": "Купите там топливные ячейки",
        "hint": "Ледяная Вега делает их дёшево, а станция Сол скупает — вкладка «Груз»",
        "reward": 100
      },
      {
        "id": "sellFuel",
        "kind": "sell",
        "place": "st:sol",
        "goods": "fuelCells",
        "title": "Вернитесь в Сол и продайте ячейки на станции",
        "hint": "Врата «→ Сол», затем станция — «ДОК», в доке — «Продать»",
        "reward": 150
      },
      {
        "id": "buy",
        "place": "st:sol",
        "goods": "machinery",
        "title": "Купите там машины",
        "hint": "Станция Сол их делает, а Новый Порт на Терре за них платит — вкладка «Груз»",
        "reward": 100
      },
      {
        "id": "sellMachinery",
        "kind": "sell",
        "place": "pl:terra",
        "goods": "machinery",
        "title": "Продайте машины в Новом Порту",
        "hint": "Круг замкнулся: Терра → Вега I → станция Сол → Терра. Теперь его можно летать самому",
        "reward": 150
      },
      {
        "id": "board",
        "title": "Возьмите задание на доске",
        "hint": "Доставка по пути выгоднее пустого перелёта: доска — первая вкладка дока",
        "reward": 100
      }
    ]
  },

  "kill": [
    { "npc": null, "min": 3, "max": 5, "reward": 80, "weight": 3 },
    { "npc": "heavyPirate", "min": 1, "max": 2, "reward": 350, "weight": 1 }
  ],
  "collect": [
    { "item": "metal", "min": 8, "max": 15, "factor": 1.8 },
    { "item": "ore", "min": 8, "max": 15, "factor": 1.8 },
    { "item": "titanium", "min": 3, "max": 6, "factor": 1.6 },
    { "item": "energy", "min": 2, "max": 4, "factor": 1.5, "weight": 0.7 },
    { "item": "crystals", "min": 2, "max": 4, "factor": 1.5, "weight": 0.5 }
  ],
  "deliver": [
    { "min": 3, "max": 8, "perUnit": 20, "perJump": 150, "weight": 2 }
  ],

  // Веса новых видов (M14) вместе дают примерно 40 % доски: работа этапа должна попадаться, а не
  // вылавливаться перебором. Приестся — резать здесь.

  // Сопровождение (M14). 500-900 кр в Ядре за 40-90 секунд и одну-три стычки — выше «убить», ниже дальней
  // доставки. Радиус 900 — это примерно экран: конвой должен быть виден, а не угадываться по стрелке.
  "escort": [
    { "minWaves": 1, "maxWaves": 3, "reward": 300, "perWave": 200, "radius": 900, "awaySeconds": 25, "weight": 1.6 }
  ],

  // Патруль (M14). Самая длинная работа этапа: 3-4 точки через всю систему, и на одной из них — засада:
  // последняя, самая злая волна из ambush. Точка не засчитывается, пока её не вычистят.
  // Звено ждёт на точке, так что радиус 700 — это «подошёл», а не «успел».
  // Плата нарочно вдвое ниже прежней: за сам бой уже идут награды за головы.
  "patrol": [
    {
      "min": 3, "max": 4, "reward": 150, "perPoint": 80,
      "npc": "ranger", "wing": 2, "rank": 1, "radius": 700, "rep": "neutral", "weight": 1.4
    }
  ],

  // Засады на конвой: чем дальше по маршруту, тем злее. Уровень растёт с опасностью системы сам.
  "ambush": [
    [{ "type": "pirate", "level": 1, "count": 2 }],
    [{ "type": "pirate", "level": 2, "count": 2 }],
    [{ "type": "pirate", "level": 2, "count": 1 }, { "type": "heavyPirate", "level": 1, "count": 1 }]
  ],

  // Письмо (M14). Платит получатель, и платит за скорость: 670 кр за один прыжок, 1510 за три.
  // Запаса примерно вдвое против чистого полёта — на один бой по дороге, но не на объезд пол-галактики.
  // Стало вольготно — первым делом резать secondsPerJump, а не награду.
  "courier": [
    { "reward": 250, "perJump": 420, "secondsPerJump": 100, "seconds": 120, "maxHops": 3, "weight": 1.2 }
  ],

  // Охота (M14). Камни идут по одному, maxAlive 8, так что шесть-десять — это полторы-три минуты.
  // Нудно — резать min/max здесь, а не крутить meteors в galaxy.json: там это меняет всю систему.
  "hunt": [
    { "size": null, "min": 6, "max": 10, "reward": 45, "weight": 1.4 },
    { "size": "large", "min": 2, "max": 3, "reward": 190, "weight": 0.8 }
  ],

  // Оборона поселения (M15). Только на доске самого поселения: станцию обороняют вторжения, а это работа
  // планеты. Волны идут от врат теми же группами, что и засады выше, — своих у налёта нет.
  // Три пропущенных удара — это заметно больше, чем «зевнул один раз», но меньше, чем «можно не стрелять».
  // Радиус 1400 — примерно полтора экрана: отойти за лутом можно, улететь на другой конец системы нельзя.
  "defend": [
    { "waves": 3, "strikes": 3, "reward": 260, "perWave": 180, "radius": 1400, "awaySeconds": 25, "gapSeconds": 6, "weight": 1.2 }
  ]
}
