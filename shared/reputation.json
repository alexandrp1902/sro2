// Репутация (M13, GDD §35). Шкала −100…+100, одна и та же для системы и для станции.
// Проверяется Sro.Sim/ReputationRules.cs; зеркало текста и цен — client/src/sim/reputation.ts.
{
  "limit": 100,

  // Ступени от худшей к лучшей. from — нижняя граница включительно, у первой это −limit.
  // price — множитель цен снаряжения и ремонта на этой ступени (спека: до ±10 %).
  "levels": [
    { "id": "enemy", "name": "Враг", "from": -100, "price": 1.1, "color": "#c0392b" },
    { "id": "distrust", "name": "Недоверие", "from": -50, "price": 1.05, "color": "#c98a2a" },
    { "id": "neutral", "name": "Нейтрал", "from": -10, "price": 1.0, "color": "#8a93a6" },
    { "id": "friend", "name": "Друг", "from": 30, "price": 0.95, "color": "#3f9f6a" },
    { "id": "hero", "name": "Герой", "from": 70, "price": 0.9, "color": "#3f7fbf" }
  ],

  // Столько очков репутация проходит к нулю за сутки. Из «Врага» (−54) это выводит за полтора дня:
  // исправиться должно быть можно, но заметно дольше, чем испортить.
  "decayPerDay": 3,

  "events": {
    // Четыре задания одной станции (≈20–30 мин) выводят её в «Друга» и открывают Mk3 — это главная петля этапа.
    "missionPlace": 8,
    "missionSystem": 2,
    "missionAbandon": -5,
    // Провал стирает ровно одно выполненное задание; честный отказ — чуть дешевле.
    "missionFail": -8,

    // Голова пирата стоит 60 кр, и очков за неё дают мало: отмыть убитого торговца (−18) стоит трёх часов
    // у потолка. Чинятся заданиями и временем, а не фармом голов.
    "pirateKill": 0.5,
    "pirateHourly": 6,

    "sosHelp": 2,
    "invasionMax": 10,

    // Три убитых торговца или два рейнджера — и система считает пилота врагом.
    "traderAttack": -6,
    "traderKill": -12,
    "traderPlace": -4,
    "rangerAttack": -10,
    "rangerKill": -25,

    // Только там, где PvP выключен или ограничен. В free-системах драка согласованная, штрафа нет.
    "playerKill": -15
  },

  // Mk3 и три топовых корпуса продают только своим. Купить их можно там, где пилота знают, —
  // репутации места или среднего по региону.
  "gate": {
    "level": "friend",
    "tiers": [3],
    "hulls": ["frigate", "freighter", "cruiser"]
  },

  // Доска заданий: у кого нет доверия, тому и работы меньше; у друзей появляется особый контракт.
  "missions": {
    "offers": { "enemy": 0, "distrust": 2 },
    "eliteFrom": "friend",
    "eliteReward": 1.5
  }
}
