// Путь пилота (M15.5): с чего начинается новый аккаунт. Выбирается один раз, на экране входа,
// и только когда ник свободен — то есть когда аккаунт заводится.
//
// Это НЕ класс: ни запретов, ни бонусов дальше старта. Путь задаёт корабль, место и первое отношение
// мира, а дальше всё решают поступки и репутация (M13). Торговец волен воевать, рейнджер — торговать.
//
// Правится на лету, как весь баланс: чтобы поменять старт, пересобирать сервер не нужно.
{
  // Выбран заранее на экране входа: не тронув ничего, игрок получает ровно то, что получал до M15.5.
  "default": "ranger",

  "careers": {
    "ranger": {
      "name": "Рейнджер",
      "hint": "Боевой корабль и станция Сол — там, где рейнджеры",
      "system": "sol",
      "place": "st:sol",
      // Стартовый набор как был: «Пчела», импульсная в первом слоте, 1000 кредитов.
      // Вторая пушка — первая покупка пилота, и отнимать у неё этот смысл нечестно.
      "hull": "light",
      "weapons": ["pulse"],
      "credits": 1000,
      "rep": { "sys:sol": 15 }
    },

    "trader": {
      "name": "Торговец",
      "hint": "Грузовой трюм и Новый Порт на Терре — там, где торгуют",
      "system": "sol",
      "place": "pl:terra",
      // «Ослик» (M18): трюм 45 против 20 у «Пчелы», зато 120 м/с и уклонение 6 — от пиратов не уйти.
      // Одна пушка из двух слотов — отбиться, а не воевать; вторая за 300 — первая покупка, как у рейнджера.
      // «Мул» с трюмом 75 — понятная цель на первые полчаса. Профилей до M18 это не касается: их «Мул» при них.
      "hull": "starterTrader",
      "weapons": ["pulse"],
      // Кредитов меньше: часть стартового капитала уже лежит в трюме товаром.
      // Продовольствие на Терре производят, значит взято оно дёшево, — и первый рейс очевиден.
      "credits": 500,
      "cargo": { "food": 40 },
      "rep": { "pl:terra": 15, "sys:sol": 5 }
    },

    // Пирату нужна своя доска, свои цели и своя репутация — это отдельный этап, а не третий набор
    // стартовых вещей. Карточка стоит в ряду затем, чтобы было видно: путь будет.
    "pirate": {
      "name": "Пират",
      "hint": "Скоро",
      "enabled": false
    }
  }
}
