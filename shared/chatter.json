{
  "//": "Радиоэфир (M17b): единственный источник правды и для речи (tools/voice.py), и для субтитров (client/src/audio/chatter.ts). В репликах нет подстановок вроде {name}: синтез не договорит имя, а расхождение звука и субтитра режет глаз. Обращения — «пилот», «борт».",
  "rules": {
    "//": "Кулдауны, чтобы эфир не тараторил: общий по обстановке, на корабль, на категорию; hailAgainMs — как часто один и тот же торговец или рейнджер здоровается заново.",
    "globalCooldownMs": { "calm": 12000, "combat": 6000 },
    "shipCooldownMs": 45000,
    "categoryCooldownMs": 30000,
    "hailAgainMs": 180000,
    "idleEveryMs": 3000,
    "idleChance": 0.25,
    "hailRange": 900,
    "civilRange": 1200,
    "hostileRange": 1600,
    "tauntAfterMs": 10000,
    "begHp": 0.3,
    "lastWordsChance": 0.5
  },
  "categories": {
    "traderHail": {
      "speaker": "trader",
      "lines": [
        { "id": 1, "voice": "m", "text": "Мирный борт. Пушки для красоты." },
        { "id": 2, "voice": "f", "text": "Не стреляйте! Кот за рулём." },
        { "id": 3, "voice": "m", "text": "Везу товар. Совесть оставил дома." },
        { "id": 4, "voice": "f", "text": "Груз хрупкий. Нервы тоже." },
        { "id": 5, "voice": "m", "text": "Привет! Скидок нет, настроение есть." },
        { "id": 6, "voice": "m", "text": "Это грузовик. Обгоняйте с молитвой." },
        { "id": 7, "voice": "f", "text": "Привет, пилот! Пираты уже обедали?" },
        { "id": 8, "voice": "m", "text": "Торговец на связи. Торг не по связи." },
        { "id": 9, "voice": "m", "text": "Расходимся! Тормоза в ремонте." },
        { "id": 10, "voice": "f", "text": "Везу руду. Звучит богаче, чем есть." },
        { "id": 11, "voice": "m", "text": "Осторожно, яйца! Страусиные. Кажется." },
        { "id": 12, "voice": "f", "text": "Добрый путь! Чеки сохраняйте." },
        { "id": 13, "voice": "f", "text": "Трюм полный. Кошелёк пустой." },
        { "id": 14, "voice": "m", "text": "Я мирный! Даже будильник боюсь." },
        { "id": 15, "voice": "f", "text": "Груз застрахован. Я на авось." },
        { "id": 16, "voice": "m", "text": "Привет! Везу пылесосы. Вакуум одобряет." },
        { "id": 17, "voice": "f", "text": "Мирный рейс. Из оружия — калькулятор." },
        { "id": 18, "voice": "m", "text": "Пропустите грузовик. Пельмени тают." }
      ]
    },
    "traderIdle": {
      "speaker": "trader",
      "lines": [
        { "id": 1, "voice": "m", "text": "Жду разгрузку. Уже сроднился с ящиками." },
        { "id": 2, "voice": "f", "text": "Металл подешевел. Я поседела." },
        { "id": 3, "voice": "m", "text": "Двигатель кашляет. Механик тоже." },
        { "id": 4, "voice": "f", "text": "Кофе кончился. Держусь на процентах." },
        { "id": 5, "voice": "m", "text": "Курс верный. Жизнь — не очень." },
        { "id": 6, "voice": "f", "text": "Везу лекарства. От жадности нет." },
        { "id": 7, "voice": "m", "text": "Проверка связи. Долги меня слышат?" },
        { "id": 8, "voice": "m", "text": "Груз закреплён. Сам болтаюсь." },
        { "id": 9, "voice": "f", "text": "Щит барахлит. Зато блестит." },
        { "id": 10, "voice": "m", "text": "Топливо почём? Уже страшно." },
        { "id": 11, "voice": "f", "text": "Опять эта песня. Космос тесен." },
        { "id": 12, "voice": "m", "text": "Ещё рейс — и куплю дворник." },
        { "id": 13, "voice": "m", "text": "Штурман заблудился. Штурман — я." },
        { "id": 14, "voice": "f", "text": "Везу носки. Все левые." },
        { "id": 15, "voice": "f", "text": "Автопилот просит отпуск. Наглец." },
        { "id": 16, "voice": "m", "text": "Груз не потерян. Он свободен." },
        { "id": 17, "voice": "m", "text": "Сирена третий день. Уже подпеваю." },
        { "id": 18, "voice": "f", "text": "Обещали пять минут. Вчера." },
        { "id": 19, "voice": "m", "text": "Кофе в трюме. Ключ в отпуске." },
        { "id": 20, "voice": "m", "text": "Корабль скрипит. Значит, ещё целый." },
        { "id": 21, "voice": "f", "text": "Это не виляние. Это экономия курса." },
        { "id": 22, "voice": "m", "text": "Пираты, у меня кирпичи. Подумайте." },
        { "id": 23, "voice": "f", "text": "Купила новый радар. Теперь долги виднее." },
        { "id": 24, "voice": "m", "text": "В невесомости живот не втягиваю." },
        { "id": 25, "voice": "f", "text": "Прибыль есть. Была. Пока заправлялась." }
      ]
    },
    "rangerHail": {
      "speaker": "ranger",
      "lines": [
        { "id": 1, "voice": "m", "text": "Патруль на связи. Вид делаем грозный." },
        { "id": 2, "voice": "f", "text": "Проблем нет? Сейчас проверим." },
        { "id": 3, "voice": "m", "text": "Летите прямо. Хотя бы морально." },
        { "id": 4, "voice": "m", "text": "Врата под охраной. Ключ потеряли." },
        { "id": 5, "voice": "f", "text": "Торговцев не трогать. Они нервные." },
        { "id": 6, "voice": "m", "text": "Нарушений нет. Даже обидно." },
        { "id": 7, "voice": "m", "text": "Счастливого пути! Без фейерверков." },
        { "id": 8, "voice": "f", "text": "Увидите пиратов — не усыновляйте." },
        { "id": 9, "voice": "m", "text": "Летите спокойно. Мы тоже боимся." },
        { "id": 10, "voice": "m", "text": "Проход открыт. Бахилы не нужны." },
        { "id": 11, "voice": "f", "text": "Скорость не ограничена. Здравый смысл желателен." },
        { "id": 12, "voice": "m", "text": "Улыбнитесь! Вы на радаре." },
        { "id": 13, "voice": "m", "text": "Права, техпаспорт... Ладно, летите." },
        { "id": 14, "voice": "f", "text": "Патруль приветствует. Взятки только пончиками." },
        { "id": 15, "voice": "m", "text": "Документы в порядке? Хоть у кого-то." },
        { "id": 16, "voice": "f", "text": "Сектор спокойный. Не сглазьте двигателем." }
      ]
    },
    "rangerWarn": {
      "speaker": "ranger",
      "lines": [
        { "id": 1, "voice": "m", "text": "В секторе бой! Зрителям разойтись." },
        { "id": 2, "voice": "f", "text": "Иду на помощь. Сирену изображаю сама." },
        { "id": 3, "voice": "m", "text": "Мирным отойти! Сейчас будет воспитание." },
        { "id": 4, "voice": "m", "text": "Вступаю в бой. Обед подождёт." },
        { "id": 5, "voice": "f", "text": "Пираты у врат. Опять без записи." },
        { "id": 6, "voice": "m", "text": "Открываю огонь. Закрывайте форточки." },
        { "id": 7, "voice": "m", "text": "Патруль в бою. Протокол потом." },
        { "id": 8, "voice": "f", "text": "Держитесь, пилот! Эвакуатор с пушками здесь." },
        { "id": 9, "voice": "m", "text": "Цель вижу. Совесть отключаю." },
        { "id": 10, "voice": "m", "text": "Мирным к станции! Тут ремонт назревает." },
        { "id": 11, "voice": "f", "text": "Пираты, стоять! Штраф летит навстречу." },
        { "id": 12, "voice": "m", "text": "Начинаем задержание. Крупным калибром." },
        { "id": 13, "voice": "f", "text": "Гражданским отойти! Аргументы заряжены." }
      ]
    },
    "convoyIdle": {
      "speaker": "convoy",
      "lines": [
        { "id": 1, "voice": "m", "text": "Строй держим. На честном слове." },
        { "id": 2, "voice": "f", "text": "Хвост чист. Совесть не проверяла." },
        { "id": 3, "voice": "m", "text": "Все на месте? По головам лень." },
        { "id": 4, "voice": "m", "text": "Идём по графику. График плачет." },
        { "id": 5, "voice": "f", "text": "Дистанцию держу. Обиду тоже." },
        { "id": 6, "voice": "m", "text": "Радар чист. Кто его протёр?" },
        { "id": 7, "voice": "m", "text": "Груз цел. Печенье не считается." },
        { "id": 8, "voice": "f", "text": "Точку прошли. Смысл пока ищем." },
        { "id": 9, "voice": "m", "text": "Ведущий, мы куда? Чисто интересно." },
        { "id": 10, "voice": "m", "text": "Третий, выключи караоке. Пираты жалуются." },
        { "id": 11, "voice": "f", "text": "Нужен штурман. Этот верит в приметы." },
        { "id": 12, "voice": "m", "text": "Держу строй. Строй меня не держит." },
        { "id": 13, "voice": "m", "text": "Ведущий, помедленнее. Чай на поворотах льётся." },
        { "id": 14, "voice": "f", "text": "Конвой цел. Пересчитала вместе с пиратом." },
        { "id": 15, "voice": "m", "text": "Третий, не храпи. Радар вибрирует." }
      ]
    },
    "pirateThreat": {
      "speaker": "pirate",
      "lines": [
        { "id": 1, "voice": "m", "text": "Груз сюда! У нас самовывоз." },
        { "id": 2, "voice": "f", "text": "Стой! Ты мне по бюджету." },
        { "id": 3, "voice": "m", "text": "А вот и премия подлетела!" },
        { "id": 4, "voice": "m", "text": "Трюм открывай. Мы с проверкой жадности." },
        { "id": 5, "voice": "f", "text": "Поворот не туда. Касса здесь." },
        { "id": 6, "voice": "m", "text": "Пираты на связи. Отписки нет." },
        { "id": 7, "voice": "m", "text": "Красивый корпус. Продырявим бесплатно." },
        { "id": 8, "voice": "f", "text": "Вижу твой груз. Уже люблю." },
        { "id": 9, "voice": "m", "text": "Окружаем! Только не толпитесь." },
        { "id": 10, "voice": "m", "text": "Груз или жизнь? Можно комплектом." },
        { "id": 11, "voice": "f", "text": "Доставка неприятностей. Распишитесь корпусом." },
        { "id": 12, "voice": "m", "text": "Вход бесплатный. Выход за корабль." },
        { "id": 13, "voice": "m", "text": "Не бойся. Это ограбление с улыбкой." },
        { "id": 14, "voice": "f", "text": "Ваш груз нам очень важен. Оставайтесь на линии." },
        { "id": 15, "voice": "m", "text": "Открывай трюм. У нас чёрная пятница." },
        { "id": 16, "voice": "f", "text": "Не убегай! Я уже потратила твои деньги." }
      ]
    },
    "pirateTaunt": {
      "speaker": "pirate",
      "lines": [
        { "id": 1, "voice": "m", "text": "Это бой или разминка пальцев?" },
        { "id": 2, "voice": "f", "text": "Щит мигает. Праздник, что ли?" },
        { "id": 3, "voice": "m", "text": "Мимо! Космос уже весь прострелил." },
        { "id": 4, "voice": "m", "text": "Корпус хрустит. Свеженький!" },
        { "id": 5, "voice": "f", "text": "Сдавайся, пока есть упаковка." },
        { "id": 6, "voice": "m", "text": "Ребята, добиваем! Обед стынет." },
        { "id": 7, "voice": "m", "text": "Ещё попадание — и ты конструктор." },
        { "id": 8, "voice": "f", "text": "Не дёргайся. Портрет испортишь." },
        { "id": 9, "voice": "m", "text": "Ты стреляешь или чихаешь?" },
        { "id": 10, "voice": "m", "text": "Прицел протри. Или глаза." },
        { "id": 11, "voice": "f", "text": "Ремонт за твой счёт!" },
        { "id": 12, "voice": "m", "text": "Ты по мне или по гороскопу стреляешь?" },
        { "id": 13, "voice": "f", "text": "Щит кончился. Продлить подписку?" },
        { "id": 14, "voice": "m", "text": "Не корабль, а дуршлаг с амбициями!" }
      ]
    },
    "beg": {
      "speaker": "pirate",
      "lines": [
        { "id": 1, "voice": "m", "text": "Стой! Я уже увольняюсь!" },
        { "id": 2, "voice": "f", "text": "Пощади! Я по объявлению!" },
        { "id": 3, "voice": "m", "text": "Сдаюсь! Пушки убери, сквозит!" },
        { "id": 4, "voice": "m", "text": "Горю! Это не спецэффект!" },
        { "id": 5, "voice": "f", "text": "Больше не буду! Даже думать!" },
        { "id": 6, "voice": "m", "text": "Не стреляй! У меня ипотека!" },
        { "id": 7, "voice": "m", "text": "Ухожу! Адреса не оставлю!" },
        { "id": 8, "voice": "f", "text": "Я на нуле! Как и зарплата!" },
        { "id": 9, "voice": "m", "text": "Твоя взяла! Мою верни!" },
        { "id": 10, "voice": "m", "text": "Пощади! У меня суп на плите!" },
        { "id": 11, "voice": "f", "text": "Я пират по выходным! Сегодня среда!" },
        { "id": 12, "voice": "m", "text": "Отпусти! Ограблю со скидкой!" },
        { "id": 13, "voice": "m", "text": "Стой! У меня испытательный срок!" },
        { "id": 14, "voice": "f", "text": "Пощади! Череп на борту — наклейка!" },
        { "id": 15, "voice": "m", "text": "Сдаюсь! Забери капитана. Это я." }
      ]
    },
    "lastWords": {
      "speaker": "pirate",
      "lines": [
        { "id": 1, "voice": "m", "text": "Гарантия... Ещё действовала..." },
        { "id": 2, "voice": "f", "text": "Горю... А обещали подогрев..." },
        { "id": 3, "voice": "m", "text": "За меня... Кредит доплатите..." },
        { "id": 4, "voice": "m", "text": "Реактор... Не та кнопка..." },
        { "id": 5, "voice": "f", "text": "Твоя взяла... Вместе с двигателем..." },
        { "id": 6, "voice": "m", "text": "Всё... Отпуск согласован..." },
        { "id": 7, "voice": "m", "text": "Маме скажите... Я бухгалтер..." },
        { "id": 8, "voice": "f", "text": "Хоть груз... Не мой..." },
        { "id": 9, "voice": "m", "text": "А ремень... Всё-таки нужен..." },
        { "id": 10, "voice": "f", "text": "Пароль от сейфа... Забыла..." }
      ]
    },
    "sos": {
      "speaker": "trader",
      "lines": [
        { "id": 1, "voice": "m", "text": "На помощь! Меня распаковывают!" },
        { "id": 2, "voice": "f", "text": "Пираты! Спасите, оплачу без торга!" },
        { "id": 3, "voice": "m", "text": "Помогите! Щит ушёл на обед!" },
        { "id": 4, "voice": "f", "text": "На нас напали! Чек не дают!" },
        { "id": 5, "voice": "m", "text": "Спасите груз! Я к нему прилагаюсь!" },
        { "id": 6, "voice": "f", "text": "Пираты на хвосте! Хвост жалко!" },
        { "id": 7, "voice": "m", "text": "Спасите! Пираты забирают даже бонусные мили!" },
        { "id": 8, "voice": "f", "text": "На помощь! Мой бизнес стал слишком горячим!" }
      ]
    },
    "thanks": {
      "speaker": "trader",
      "lines": [
        { "id": 1, "voice": "m", "text": "Спасибо! Живой, но опять небогатый." },
        { "id": 2, "voice": "f", "text": "Спасли! Кредиты летят быстрее меня." },
        { "id": 3, "voice": "m", "text": "Благодарю! Премия вам, валерьянка мне." },
        { "id": 4, "voice": "f", "text": "Спасибо! Ангел с пушками — это удобно." },
        { "id": 5, "voice": "m", "text": "Спасибо! Отзыв будет на пять звёзд." },
        { "id": 6, "voice": "f", "text": "Отбились! С меня кофе. Маленький." },
        { "id": 7, "voice": "f", "text": "Спасибо! Завещание снова в черновики." },
        { "id": 8, "voice": "m", "text": "Спасли! Кот тоже доволен. Почти." },
        { "id": 9, "voice": "m", "text": "Спасибо! Назову в вашу честь накладную." },
        { "id": 10, "voice": "f", "text": "Спасли! Даже жаба разрешила заплатить." }
      ]
    }
  }
}
